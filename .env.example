# Copy to .env. Leave KALKAN_API_KEYS empty for local dev (auth disabled).
# One entry per consuming chatbot: name:key  (generate keys with: python -c "import secrets;print(secrets.token_urlsafe(32))")
KALKAN_API_KEYS=
KALKAN_ADMIN_KEY=
KALKAN_DB=/app/var/kalkan.db
# none | flagged | all  - which request texts are stored in the audit log (hash is always stored)
KALKAN_LOG_TEXT=flagged
KALKAN_MAX_CHARS=32000
# Optional per-client thresholds, JSON file mounted into the container
# KALKAN_POLICIES=/app/policies.json
